    { Name = "Visuals", Icon = "\226\151\137" }, { Name = "Rage", Icon = "\226\154\161" },
    { Name = "Auto Farm", Icon = "\226\152\152" }, { Name = "World", Icon = "\240\159\140\144" },
    { Name = "Settings", Icon = "\226\154\153" },
}

local railButtons, navRows, contentFrames = {}, {}, {}

local function SelectTab(name)
    for n, f in pairs(contentFrames) do f.Visible = (n == name) end
    for n, b in pairs(railButtons) do
        Tween(b, { BackgroundColor3 = n == name and Theme.Hover or Theme.Rail }, 0.1)
        b.TextColor3 = n == name and Theme.Accent or Theme.SubText
    end
    for n, r in pairs(navRows) do
        Tween(r.Bar, { BackgroundTransparency = n == name and 0 or 1 }, 0.1)
        Tween(r.Frame, { BackgroundColor3 = n == name and Theme.Hover or Theme.Panel }, 0.1)
        r.Label.TextColor3 = n == name and Theme.Text or Theme.SubText
    end
    TabTitle.Text, TabSub.Text = name, TabDesc[name]
end

for i, tab in ipairs(Tabs) do
    local railBtn = New("TextButton", { Size = UDim2.new(0, 40, 0, 40), Position = UDim2.new(0, 9, 0, 10 + (i - 1) * 48),
        BackgroundColor3 = Theme.Rail, Text = tab.Icon, Font = Font, TextSize = 18,
        TextColor3 = Theme.SubText, AutoButtonColor = false, Parent = IconRail }, { Corner(8) })
    railButtons[tab.Name] = railBtn
    railBtn.MouseButton1Click:Connect(function() SelectTab(tab.Name) end)
    railBtn.MouseEnter:Connect(function() if TabTitle.Text ~= tab.Name then Tween(railBtn, { BackgroundColor3 = Theme.Hover }, 0.1) end end)
    railBtn.MouseLeave:Connect(function() if TabTitle.Text ~= tab.Name then Tween(railBtn, { BackgroundColor3 = Theme.Rail }, 0.1) end end)

    local navRow = New("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Panel, Parent = TabList }, { Corner(6) })
    local bar = New("Frame", { Size = UDim2.new(0, 3, 1, -8), Position = UDim2.new(0, 0, 0, 4),
        BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, Parent = navRow }, { Corner(2) })
    New("TextLabel", { Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1,
        Text = tab.Icon, Font = Font, TextSize = 14, TextColor3 = Theme.SubText, Parent = navRow })
    local navLabel = New("TextLabel", { Size = UDim2.new(1, -40, 1, 0), Position = UDim2.new(0, 36, 0, 0),
        BackgroundTransparency = 1, Text = tab.Name, Font = Font, TextSize = 13, TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = navRow })
    New("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = navRow }).MouseButton1Click:Connect(function()
        SelectTab(tab.Name)
    end)
    navRow.MouseEnter:Connect(function() if TabTitle.Text ~= tab.Name then Tween(navRow, { BackgroundColor3 = Theme.Hover }, 0.1) end end)
    navRow.MouseLeave:Connect(function() if TabTitle.Text ~= tab.Name then Tween(navRow, { BackgroundColor3 = Theme.Panel }, 0.1) end end)
    navRows[tab.Name] = { Bar = bar, Frame = navRow, Label = navLabel }

    contentFrames[tab.Name] = New("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Visible = false, Parent = RightSide })
end

