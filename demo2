-- Blocky character
local cConn = nil
local function applyB(ch)
    if not ch then return end
    task.wait(0.6)
    pcall(function()
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("SpecialMesh") then
                local pp = p.Parent
                if pp and pp:IsA("BasePart") and pp.Name ~= "Head" then
                    p.MeshType=Enum.MeshType.Brick; p.Scale=Vector3.new(1,1,1); p.MeshId=""; p.TextureId=""
                end
            end
            if p:IsA("MeshPart") and p.Name ~= "Head" then
                local sm = p:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh", p)
                sm.MeshType = Enum.MeshType.Brick; sm.Scale = Vector3.new(1,1,1)
            end
        end
        local head = ch:FindFirstChild("Head")
        if head then
            local hm = head:FindFirstChildOfClass("SpecialMesh")
            if hm then hm.MeshType = Enum.MeshType.Head; hm.MeshId = "" end
        end
    end)
end
local function enB()
    Cfg.BlockyEnabled = true
    if LocalPlayer.Character then task.spawn(applyB, LocalPlayer.Character) end
    cConn = LocalPlayer.CharacterAdded:Connect(function(c)
        if Cfg.BlockyEnabled then task.spawn(applyB, c) end
    end)
end
local function disB()
    Cfg.BlockyEnabled = false
    if cConn then cConn:Disconnect(); cConn = nil end
    pcall(function() LocalPlayer:LoadCharacter() end)
end

