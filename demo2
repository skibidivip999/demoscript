local function newUDim2(x, y) return UDim2.new(x, y) end

local function mkCorner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function mkStroke(parent: Instance, thickness: number, color: Color3, transparency: number)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Color = color
	s.Transparency = transparency
	s.Parent = parent
	return s
end

local function mkGradient(parent: Instance, color1: Color3, color2: Color3)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(color1, color2)
	g.Rotation = 90
	g.Transparency = NumberSequence.new(0, 0.15)
	g.Parent = parent
	return g
end

