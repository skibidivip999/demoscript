        BackgroundColor3 = default and Theme.Accent or Theme.ToggleOff, Parent = row }, { Corner(10) })
    local dot = New("Frame", { Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = Color3.new(1, 1, 1), Parent = track }, { Corner(8) })
    local btn = New("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = track })
    local state = default
    btn.MouseButton1Click:Connect(function()
        state = not state
