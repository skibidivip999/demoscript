----------------------------------------------------------------
-- TARGETING CORE
----------------------------------------------------------------
local function GetClosestTarget(fovPx, hitboxName, requireLOS)
    local best, bestDist
    local originPos = Camera.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            local part = plr.Character:FindFirstChild(hitboxName) or hrp
            if hrp and hum and hum.Health > 0 and part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local center = Camera.ViewportSize / 2
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist2D <= fovPx then
                        local ok = true
                        if requireLOS then
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = { LocalPlayer.Character }
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            local rc = Workspace:Raycast(originPos, part.Position - originPos, params)
                            if rc and rc.Instance and not rc.Instance:IsDescendantOf(plr.Character) then
                                ok = false
                            end
                        end
                        if ok and (not bestDist or dist2D < bestDist) then
                            bestDist, best = dist2D, part
                        end
                    end
                end
            end
        end
    end
    return best
end

----------------------------------------------------------------
-- AIMBOT / TRIGGER / AUTOSHOOT / RAPIDFIRE / RELOAD STEPS
----------------------------------------------------------------
local function AimbotStep()
    if not Aimbot.Master or not Aimbot.Enabled then return end
    if Aimbot.Keybind and not UserInputService:IsKeyDown(Aimbot.Keybind) then return end
    local target = GetClosestTarget(Aimbot.FOV, Aimbot.Hitbox, not Wallbang.Enabled)
    if not target then return end
    local targetPos = target.Position
    if Aimbot.Prediction then
        local hrp = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
        local vel = hrp and hrp.AssemblyLinearVelocity or Vector3.new()
        targetPos = targetPos + vel * 0.15
    end
    local goal = CFrame.new(Camera.CFrame.Position, targetPos)
    local alpha = math.clamp(1 / math.max(Aimbot.Smooth, 0.01), 0.05, 1)
    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end

local triggerDebounce = false
local function TriggerbotStep()
    if not Triggerbot.Enabled or triggerDebounce then return end
    local target = GetClosestTarget(Aimbot.FOV, SilentAim.Part, not Wallbang.Enabled)
    if target then
        triggerDebounce = true
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
        task.delay(Triggerbot.Delay, function() triggerDebounce = false end)
    end
end

local lastShot = 0
local function AutoShootStep()
    if not AutoShoot.Enabled then return end
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
    local now = os.clock()
    if now - lastShot < 1 / math.max(AutoShoot.RateHz, 1) then return end
    lastShot = now
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool then tool:Activate() end
end

local function RapidFireStep()
    if not RapidFire.Enabled then return end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    for _, name in ipairs({ "Cooldown", "Debounce", "FireRate" }) do
        if tool:GetAttribute(name) ~= nil then tool:SetAttribute(name, 0) end
    end
    if tool:GetAttribute("CanFire") ~= nil then tool:SetAttribute("CanFire", true) end
end

local function FasterReloadStep()
    if not FasterReload.Enabled then return end
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    local ammo, maxAmmo = tool:GetAttribute("Ammo"), tool:GetAttribute("MaxAmmo")
    if ammo and maxAmmo and ammo < maxAmmo then tool:SetAttribute("Ammo", maxAmmo) end
    if tool:GetAttribute("ReloadTime") ~= nil then tool:SetAttribute("ReloadTime", 0.05) end
end

----------------------------------------------------------------
-- SILENT AIM HOOK (mouse metamethod, no camera movement)
----------------------------------------------------------------
pcall(function()
    local mouse = LocalPlayer:GetMouse()
    if not hookmetamethod then return end
    local oldIndex = hookmetamethod(mouse, "__index", function(self, key)
        if SilentAim.Enabled and (key == "Hit" or key == "Target") then
            local target = GetClosestTarget(Aimbot.FOV, SilentAim.Part, not Wallbang.Enabled)
            if target then
                if key == "Hit" then return CFrame.new(target.Position) end
                if key == "Target" then return target end
            end
        end
        return oldIndex(self, key)
    end)
end)

----------------------------------------------------------------
-- ANTI-CHEAT / ANTI-DETECTION BYPASS
----------------------------------------------------------------
local function InitAntiCheat()
    if not (getrawmetatable and setreadonly and newcclosure and getnamecallmethod) then
        AntiCheat.Status = "Unsupported"
        return
    end
    local ok = pcall(function()
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if AntiCheat.Enabled then
                if method == "Kick" and self == LocalPlayer then return end
                if method == "FireServer" or method == "InvokeServer" then
                    local n = (self.Name or ""):lower()
                    if n:find("anticheat") or n:find("detect") or n:find("report") or n:find("banned") or n:find("flag") then
                        return
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)
    pcall(function()
        if identifyexecutor then
            identifyexecutor = function() return "Roblox", "1.0" end
        end
    end)
    AntiCheat.Status = ok and "Active" or "Failed"
end

