-- Wallbang
local wbH = false
local function setupWB()
    if wbH then return end; wbH = true
    pcall(function()
        local _o = workspace.Raycast
        workspace.Raycast = function(self, o, d, p)
            if Cfg.WallbangEnabled then
                local nw = RaycastParams.new()
                nw.FilterType = Enum.RaycastFilterType.Exclude
                nw.FilterDescendantsInstances = {LocalPlayer.Character or Instance.new("Folder")}
                local r = _o(self, o, d, nw)
                if r then
                    local m = r.Instance:FindFirstAncestorOfClass("Model")
                    if m then
                        local pl = Players:GetPlayerFromCharacter(m)
                        if pl and pl ~= LocalPlayer then
                            if not (Cfg.TeamCheck and pl.Team == LocalPlayer.Team) then
                                local h = m:FindFirstChildOfClass("Humanoid")
                                if h and h.Health > 0 then return r end
                            end
                        end
                    end
                end
            end
            return _o(self, o, d, p)
        end
    end)
end
setupWB()

