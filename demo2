local function unlockSkins()
    pcall(function()
        for _, o in ipairs(game:GetDescendants()) do
            local n = o.Name:lower()
            if n:find("unlock") or n:find("skin") or n:find("cosmetic")
            or n:find("inventory") or n:find("trail") or n:find("emote") then
                if o:IsA("RemoteFunction") then pcall(function() o:InvokeServer("unlock_all") end)
                elseif o:IsA("RemoteEvent") then
