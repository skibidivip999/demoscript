local rlHooked=false
local function setupFasterReload()
    if rlHooked then return end; rlHooked=true
    task.spawn(function()
        local function hr(obj)
            if not obj:IsA("RemoteEvent") then return end
            local n=obj.Name:lower()
            if not(n:find("reload") or n:find("ammo")) then return end
            pcall(function()
                local _o=obj.FireServer
