-- Target finder
local function getTarget(fov)
    local best, bd = nil, fov
    local cx = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if Cfg.TeamCheck and p.Team == LocalPlayer.Team then continue end
        local ch = p.Character; if not ch then continue end
        local pt = ch:FindFirstChild(Cfg.AimbotPart) or ch:FindFirstChild("HumanoidRootPart")
        if not pt then continue end
        local hm = ch:FindFirstChildOfClass("Humanoid")
        if not hm or hm.Health <= 0 then continue end
        local sp, on = Camera:WorldToViewportPoint(pt.Position)
        if not on then continue end
        local d = (Vector2.new(sp.X, sp.Y) - cx).Magnitude
        if d < bd then bd = d; best = p end
    end
    return best
end

-- Prediction
local function predPos(ch, pt)
    if not Cfg.PredOn then return pt.Position end
    local r = ch:FindFirstChild("HumanoidRootPart")
    if not r then return pt.Position end
    return pt.Position + r.AssemblyLinearVelocity * (LocalPlayer:GetNetworkPing() + Cfg.PredStr)
end

-- Fire weapon (with anti-detect rate limit)
