-- B4: Debug reflection bypass
pcall(function()
    if debug then
        if debug.getinfo then
            local _di = debug.getinfo
            debug.getinfo = newcclosure(function(lvl, what)
                local ok, info = pcall(_di, lvl, what)
                if not ok then return nil end
                if info and not checkcaller() then
                    local src = tostring(info.source or ""):lower()
                    if src:find("nn") or src:find("bypass") then
                        info.source    = "[C]"
                        info.short_src = "[C]"
                        info.what      = "C"
                        info.currentline = -1
                    end
                end
                return info
            end)
        end

        if debug.traceback then
            local _dt = debug.traceback
            debug.traceback = newcclosure(function(thread, msg, level)
                local ok, tb = pcall(_dt, thread, msg, level)
                if ok and type(tb) == "string" then
                    tb = tb:gsub("[^\n]*[Nn][Nn][^\n]*\n?", "")
                    tb = tb:gsub("[^\n]*bypass[^\n]*\n?", "")
                end
                return ok and tb or ""
            end)
        end

        if debug.getupvalue then
            local _du = debug.getupvalue
            debug.getupvalue = newcclosure(function(f, idx)
                if not checkcaller() then
                    return nil, nil
                end
                return _du(f, idx)
            end)
        end
    end
end)

