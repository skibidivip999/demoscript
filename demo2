-- BLOCKY CHARACTER
local charConn=nil
local function applyBlocky(char)
    if not char then return end
    task.wait(0.6)
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA("SpecialMesh") then
            local p=part.Parent
            if p and p:IsA("BasePart") and p.Name~="Head" then
                part.MeshType=Enum.MeshType.Brick; part.Scale=Vector3.new(1,1,1); part.MeshId=""; part.TextureId=""
            end
        end
        if part:IsA("MeshPart") and part.Name~="Head" then
            local sm=part:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh",part)
            sm.MeshType=Enum.MeshType.Brick; sm.Scale=Vector3.new(1,1,1)
        end
    end
    local head=char:FindFirstChild("Head")
    if head then
        local hm=head:FindFirstChildOfClass("SpecialMesh")
        if hm then hm.MeshType=Enum.MeshType.Head; hm.MeshId="" end
    end
end
local function enableBlocky()
    Config.BlockyEnabled=true
    if LocalPlayer.Character then task.spawn(applyBlocky,LocalPlayer.Character) end
    charConn=LocalPlayer.CharacterAdded:Connect(function(c) if Config.BlockyEnabled then task.spawn(applyBlocky,c) end end)
end
local function disableBlocky()
    Config.BlockyEnabled=false
    if charConn then charConn:Disconnect(); charConn=nil end
    LocalPlayer:LoadCharacter()
end

