-- A3: Existing remote nullification (hook suspicious remotes directly)
local function hookSuspiciousRemote(obj)
    if not (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then return end
    local name = obj.Name:lower()
    for _, p in ipairs(BLOCKED_A) do
        if name:find(p, 1, true) then
            pcall(function()
                hookfunction(obj.FireServer, newcclosure(function() return end))
            end)
            break
        end
    end
end

