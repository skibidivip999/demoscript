local SkinUnlocker = {}
function SkinUnlocker.UnlockAll()
    local RS = game:GetService("ReplicatedStorage")
    local ok, folder = pcall(function()
        return RS:FindFirstChild("Skins", true) or RS:FindFirstChild("SkinData", true)
    end)
    if not ok or not folder then return false, 0 end
    local count = 0
    for _, item in ipairs(folder:GetDescendants()) do
        if item:IsA("ModuleScript") or item:IsA("Configuration") then
            pcall(function() LocalPlayer:SetAttribute("Skin_" .. item.Name, true) end)
            count = count + 1
        end
    end
    return true, count
end

