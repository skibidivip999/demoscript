                    local n=item.Name:lower()
                    if n:find("owned") or n:find("unlocked") or n:find("purchased") or n:find("has") then item.Value=true end
                end
                if item:IsA("NumberValue") then
                    local n=item.Name:lower()
                    if n:find("coins") or n:find("cash") or n:find("gems") then item.Value=999999 end
                end
            end
        end
    end)
