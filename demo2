local function refreshTabs()
    for n,d in pairs(tBtns) do
        if n==curT then d.bg.BackgroundColor3=K.ACTTAB; d.bar.Visible=true; d.lbl.TextColor3=K.TEXT
        else d.bg.BackgroundColor3=Color3.fromRGB(11,11,17); d.bar.Visible=false; d.lbl.TextColor3=K.SUB end
    end
end

local function buildTabs(iid)
    for _,c in ipairs(TSc:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
    tBtns={}
    for _,tn in ipairs(TABS[iid] or {}) do
        local bg=Instance.new("Frame"); bg.Size=UDim2.new(1,-6,0,33); bg.BackgroundColor3=Color3.fromRGB(11,11,17); bg.BorderSizePixel=0; bg.Parent=TSc
        Instance.new("UICorner",bg).CornerRadius=UDim.new(0,5)
        local bar=Instance.new("Frame"); bar.Size=UDim2.new(0,3,0,16); bar.Position=UDim2.new(0,0,0.5,-8); bar.BackgroundColor3=K.TBAR; bar.BorderSizePixel=0; bar.Visible=false; bar.Parent=bg
        Instance.new("UICorner",bar).CornerRadius=UDim.new(0,3)
        local lbl=Instance.new("TextLabel"); lbl.Size=UDim2.new(1,-18,1,0); lbl.Position=UDim2.new(0,14,0,0); lbl.BackgroundTransparency=1; lbl.Text=tn; lbl.TextColor3=K.SUB; lbl.TextSize=12; lbl.Font=Enum.Font.GothamBold; lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=bg
        local btn=Instance.new("TextButton"); btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=bg
        tBtns[tn]={bg=bg,bar=bar,lbl=lbl}
        bg.MouseEnter:Connect(function() if tn~=curT then bg.BackgroundColor3=K.ROWH end end)
        bg.MouseLeave:Connect(function() if tn~=curT then bg.BackgroundColor3=Color3.fromRGB(11,11,17) end end)
        btn.MouseButton1Click:Connect(function()
            curT=tn; refreshTabs(); loadContent(curI,tn)
        end)
    end
end

