-- Triggerbot
local lTrig = 0
local function chkTrig()
    if not Cfg.TrigEnabled then return end
    local now = tick(); if now - lTrig < Cfg.TrigDelay then return end
    pcall(function()
        local ray = Camera:ScreenPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.FilterDescendantsInstances = {LocalPlayer.Character or Instance.new("Folder")}
        local r = workspace:Raycast(ray.Origin, ray.Direction * 1500, p)
        if not r then return end
        local m = r.Instance:FindFirstAncestorOfClass("Model"); if not m then return end
        local pl = Players:GetPlayerFromCharacter(m)
        if not pl or pl == LocalPlayer then return end
        if Cfg.TeamCheck and pl.Team == LocalPlayer.Team then return end
        local h = m:FindFirstChildOfClass("Humanoid")
        if not h or h.Health <= 0 then return end
        lTrig = now; fireW()
    end)
end

