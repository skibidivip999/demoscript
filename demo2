-- A1: __namecall master hook
pcall(function()
    local _nc
    _nc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local ok, m = pcall(getnamecallmethod)
        if not ok then return _nc(self, ...) end
        local name = tostring(self.Name):lower()

        -- Block AC remotes
        if m == "FireServer" or m == "InvokeServer"
        or m == "FireAllClients" or m == "FireClient" then
            for _, p in ipairs(BLOCKED_A) do
                if name:find(p, 1, true) then
                    return m == "InvokeServer" and true or nil
                end
            end
        end

        -- Block BindableEvent fires that look like AC
        if m == "Fire" or m == "Invoke" then
            for _, p in ipairs(BLOCKED_A) do
                if name:find(p, 1, true) then return nil end
            end
        end

        -- Block Kick
        if m == "Kick" and self == LocalPlayer then return end

        -- Block Destroy on our GUI
        if m == "Destroy" then
            pcall(function()
                if self and tostring(self.Name):lower():find("nn_") then return end
            end)
        end

        return _nc(self, ...)
    end))
end)

