-- Sidebar icon buttons (use placeholders until you swap asset ids)
local iconSize = UDim2.new(0, 58, 0, 52)
local icons = {
	{ id = "home", label = "Home" },
	{ id = "combat", label = "Combat" },
	{ id = "visuals", label = "Visuals" },
	{ id = "rage", label = "Rage" },
	{ id = "autofarm", label = "AutoFarm" },
	{ id = "world", label = "World" },
	{ id = "settings", label = "Settings" },
}
local activeSidebarIndex = 3

local iconButtons: {[string]: ImageButton} = {}

for i, it in ipairs(icons) do
	local btn = mkIconButton(iconSize)
	btn.Position = UDim2.new(0, 0, 0, 96 + (i - 1) * 58)
	btn.Parent = sidebar
	btn.Name = it.id

	-- Default icon: simple white square (no asset); you can replace with Image asset
	local placeholder = Instance.new("Frame")
	placeholder.BackgroundColor3 = Color3.fromRGB(200, 200, 210)
	placeholder.BackgroundTransparency = 0.85
	placeholder.BorderSizePixel = 0
	placeholder.Size = UDim2.new(0, 18, 0, 18)
	placeholder.Position = UDim2.new(0.5, -9, 0, 16)
	placeholder.Parent = btn
	mkCorner(placeholder, 6)

	local hoverBg = Instance.new("Frame")
	hoverBg.BackgroundColor3 = Color3.fromRGB(120, 70, 255)
	hoverBg.BackgroundTransparency = 1
	hoverBg.BorderSizePixel = 0
	hoverBg.Size = UDim2.new(1, 0, 1, 0)
	hoverBg.Parent = btn
	mkCorner(hoverBg, 14)

	local function setActive(isActive: boolean)
		if isActive then
			placeholder.BackgroundTransparency = 0.55
			hoverBg.BackgroundTransparency = 0.85
		else
			placeholder.BackgroundTransparency = 0.85
			hoverBg.BackgroundTransparency = 1
		end
	end

	setActive(i == activeSidebarIndex)

	btn.MouseEnter:Connect(function()
		if btn.Visible then
			if i ~= activeSidebarIndex then
				hoverTween(hoverBg, true, 0.2)
			end
		end
	end)

	btn.MouseLeave:Connect(function()
		if i ~= activeSidebarIndex then
			hoverTween(hoverBg, false, 1)
		end
	end)

	btn.MouseButton1Click:Connect(function()
		local oldIndex = activeSidebarIndex
		activeSidebarIndex = i
		-- move accent bar
		TweenService:Create(accentBar, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, 0, 0, 112 + (activeSidebarIndex - 3) * 58),
		}):Play()

		for j, bIt in ipairs(icons) do
			local b = iconButtons[bIt.id]
			if b then
				-- toggle child placeholder/hover quickly
				local ph = b:FindFirstChildOfClass("Frame")
				if ph and ph.Name ~= "" then
					-- first child might be placeholder
				end
			end
		end

		-- re-evaluate active states by index
		for j, it2 in ipairs(icons) do
			local b2 = iconButtons[it2.id]
			if b2 then
				local childFrames = {}
				for _, ch in ipairs(b2:GetChildren()) do
					if ch:IsA("Frame") then table.insert(childFrames, ch) end
				end
				-- best-effort: assume one placeholder + one hoverBg
				local placeholderFrame = childFrames[1]
				local hoverFrame = childFrames[2]
				if placeholderFrame then
					placeholderFrame.BackgroundTransparency = (j == activeSidebarIndex) and 0.55 or 0.85
				end
				if hoverFrame then
					hoverFrame.BackgroundTransparency = (j == activeSidebarIndex) and 0.85 or 1
				end
			end
		end
	end)

	iconButtons[it.id] = btn
end

