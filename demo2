local function mkToggle(body: Instance, order: number, toggleDef: ToggleDef)
	local container = Instance.new("Frame")
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.new(1, 0, 0, 26)
	container.LayoutOrder = order
	container.Parent = body

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 1, 0)
	row.Parent = container

	local lbl = mkRowLabel(toggleDef.label)
	lbl.Position = UDim2.new(0, 0, 0, 0)
	lbl.Parent = row

	local switch = Instance.new("Frame")
	switch.Size = UDim2.new(0, 46, 0, 22)
	switch.Position = UDim2.new(1, -46, 0, 2)
	switch.BackgroundColor3 = Color3.fromRGB(80, 80, 92)
	switch.BackgroundTransparency = 0
	switch.BorderSizePixel = 0
	switch.Parent = row
	mkCorner(switch, 999)

	mkStroke(switch, 1, Color3.fromRGB(140, 100, 245), 0.6)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 18, 0, 18)
	knob.Position = UDim2.new(0, 2, 0, 2)
	knob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
	knob.BorderSizePixel = 0
	knob.Parent = switch
	mkCorner(knob, 999)

	local baseOn = toggleDef.default
	setConfigBool(toggleDef.id, baseOn)
	local on = baseOn

	local function applyState()
		if on then
			switch.BackgroundColor3 = Color3.fromRGB(147, 80, 255)
			knob.BackgroundColor3 = Color3.fromRGB(245, 245, 255)
			TweenService:Create(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 26, 0, 2),
			}):Play()
		else
			switch.BackgroundColor3 = Color3.fromRGB(80, 80, 92)
			knob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
			TweenService:Create(knob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 2, 0, 2),
			}):Play()
		end
	end
	applyState()

	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.BorderSizePixel = 0
	hit.Text = ""
	hit.Size = switch.Size
	hit.Position = switch.Position
	hit.Parent = row
	mkCorner(hit, 999)

	local hoverFrame = Instance.new("Frame")
	hoverFrame.BackgroundColor3 = Color3.fromRGB(147, 80, 255)
	hoverFrame.BackgroundTransparency = 1
	hoverFrame.BorderSizePixel = 0
	hoverFrame.Size = UDim2.new(1, 6, 1, 6)
	hoverFrame.Position = UDim2.new(-0.05, -3, -0.05, -3)
	hoverFrame.Parent = row
	mkCorner(hoverFrame, 18)

	hit.MouseEnter:Connect(function()
		if not on then
			hoverFrame.BackgroundTransparency = 0.85
		end
	end)
	hit.MouseLeave:Connect(function()
		hoverFrame.BackgroundTransparency = 1
	end)

	hit.MouseButton1Click:Connect(function()
		on = not on
		setConfigBool(toggleDef.id, on)
		applyState()
	end)

	return container
end

