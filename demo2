				TextColor3 = Color3.fromRGB(210, 210, 225),
			}):Play()
		end)

		ob.MouseButton1Click:Connect(function()
			setConfigStr(def.id, opt)
			btn.Text = opt .. " ▾"
			-- close
			TweenService:Create(listFrame, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(0.45, 0, 0, 0),
			}):Play()
		end)
	end

	local open = false
	btn.MouseButton1Click:Connect(function()
		open = not open
		local targetH = open and (math.min(7, #def.options) * 28 + 8) or 0
		TweenService:Create(listFrame, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0.45, 0, 0, targetH),
		}):Play()
	end)

	-- close on outside click
	do
		local function hookOutside()
			-- single connection; cheap guard: only runs if dropdown open
			local conn: RBXScriptConnection?
			conn = UserInputService.InputBegan:Connect(function(input)
				if not open then
					if conn then conn:Disconnect() end
					return
				end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					-- close (best effort)
					open = false
					TweenService:Create(listFrame, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = UDim2.new(0.45, 0, 0, 0),
					}):Play()
					if conn then conn:Disconnect() end
				end
			end)
		end
		hookOutside()
	end

	return container
end

local function mkSlider(body: Instance, order: number, def: SliderDef)
	local container = Instance.new("Frame")
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.Size = UDim2.new(1, 0, 0, 40)
	container.LayoutOrder = order
	container.Parent = body

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Text = def.label
	lbl.Font = Enum.Font.Gotham
	lbl.TextScaled = true
	lbl.TextSize = 14
	lbl.TextColor3 = Color3.fromRGB(220, 220, 235)
	lbl.Size = UDim2.new(0.55, -10, 1, 0)
	lbl.Position = UDim2.new(0, 0, 0, 0)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = container

	local valueLabel = Instance.new("TextLabel")
	valueLabel.BackgroundTransparency = 1
	valueLabel.Font = Enum.Font.GothamSemibold
	valueLabel.TextScaled = true
	valueLabel.TextSize = 14
	valueLabel.TextColor3 = Color3.fromRGB(185, 145, 255)
	valueLabel.Text = tostring(def.default)
	valueLabel.Size = UDim2.new(0.45, 0, 1, 0)
	valueLabel.Position = UDim2.new(0.55, 0, 0, 0)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = container

	local track = Instance.new("Frame")
	track.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
	track.BorderSizePixel = 0
	track.BackgroundTransparency = 0.15
	track.Size = UDim2.new(1, -10, 0, 8)
	track.Position = UDim2.new(0, 5, 1, -18)
	track.Parent = container
	mkCorner(track, 999)
	mkStroke(track, 1, Color3.fromRGB(120, 80, 255), 0.65)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.fromRGB(147, 80, 255)
	fill.BackgroundTransparency = 0
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.Position = UDim2.new(0, 0, 0, 0)
	fill.Parent = track
	mkCorner(fill, 999)

	local knob = Instance.new("Frame")
	knob.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
	knob.BorderSizePixel = 0
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.Position = UDim2.new(0, 0, 0, (track.Size.Y.Offset - 14) / 2)
	knob.Parent = track
	mkCorner(knob, 999)

	local minV, maxV = def.min, def.max
	local v = def.default
	setConfigNum(def.id, v)

	local function apply(val: number)
		v = math.clamp(val, minV, maxV)
		setConfigNum(def.id, v)
		valueLabel.Text = string.format("%.2f", v)

		local t = (v - minV) / (maxV - minV)
		local trackW = track.AbsoluteSize.X
		local usableW = math.max(1, trackW - 14)
		local px = t * usableW
		fill.Size = UDim2.new(0, px + 7, 1, 0)
		knob.Position = UDim2.new(0, px, 0, (track.Size.Y.Offset - 14) / 2)
	end
	apply(v)

	local dragging = false
	local function setFromX(absX: number)
		local left = track.AbsolutePosition.X
		local trackW = track.AbsoluteSize.X
		local usableW = math.max(1, trackW - 14)
		local px = math.clamp(absX - left - 7, 0, usableW)
		local t = px / usableW
		local val = minV + t * (maxV - minV)
		apply(val)
	end

	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.BorderSizePixel = 0
	hit.Text = ""
	hit.Size = track.Size
	hit.Position = track.Position
	hit.Parent = container

	hit.MouseButton1Down:Connect(function(x, y)
		dragging = true
		setFromX((hit.AbsolutePosition.X + (x * hit.AbsoluteSize.X)))
	end)
	hit.MouseButton1Up:Connect(function()
		dragging = false
	end)

	local moveConn: RBXScriptConnection?
	moveConn = UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		setFromX(input.Position.X)
	end)

	hit.MouseEnter:Connect(function()
		TweenService:Create(track, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 0.08,
		}):Play()
	end)
	hit.MouseLeave:Connect(function()
		TweenService:Create(track, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundTransparency = 0.15,
		}):Play()
	end)

	return container
end

