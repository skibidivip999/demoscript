-- SKIN UNLOCKER
local function unlockAllCosmetics()
    pcall(function()
        for _,obj in ipairs(game:GetDescendants()) do
            local n=obj.Name:lower()
            if n:find("unlock") or n:find("skin") or n:find("cosmetic")
            or n:find("inventory") or n:find("icon") or n:find("effect")
            or n:find("hat") or n:find("trail") or n:find("emote") then
                if obj:IsA("RemoteFunction") then pcall(function() obj:InvokeServer("unlock_all") end)
                elseif obj:IsA("RemoteEvent") then
                    pcall(function() obj:FireServer("unlock_all") end)
