-- AD1: Normalize camera movement speed (human-like rate limit)
local lastCamCF   = CFrame.new()
local MAX_CAM_RAD = 0.35 -- max radians per frame before flagged
RunService.RenderStepped:Connect(function()
    if not Cfg.AntiDetect then return end
    pcall(function()
        local cur  = Camera.CFrame
        local diff = math.abs(lastCamCF:ToObjectSpaceRotation(cur))
        if type(diff) == "number" and diff > MAX_CAM_RAD then
            -- Rate limit — lerp instead of allowing instant snap to reach server
            Camera.CFrame = lastCamCF:Lerp(cur, MAX_CAM_RAD / diff)
        end
        lastCamCF = Camera.CFrame
    end)
end)

-- AD2: Velocity clamping — prevent speed-hack detection
local WALK_SPEED_MAX = 28 -- slightly above max to allow for lag
RunService.Heartbeat:Connect(function()
    if not Cfg.AntiDetect then return end
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local vel = root.AssemblyLinearVelocity
        local mag = Vector3.new(vel.X, 0, vel.Z).Magnitude
        if mag > WALK_SPEED_MAX then
            local ratio = WALK_SPEED_MAX / mag
            root.AssemblyLinearVelocity = Vector3.new(
                vel.X * ratio, vel.Y, vel.Z * ratio
            )
        end
    end)
end)

