-- AD5: Hit validation normalization
-- Hook shoot remotes to ensure hit data looks server-valid
local function wrapShootRemote(remote)
    if not remote:IsA("RemoteEvent") then return end
    local name = remote.Name:lower()
    if not (name:find("shoot") or name:find("fire") or name:find("bullet") or name:find("hit")) then return end
    pcall(function()
        local _orig = remote.FireServer
        hookfunction(_orig, newcclosure(function(self, ...)
            if not Cfg.AntiDetect then return _orig(self, ...) end
            -- Rate limit: never fire faster than MIN_SHOT_INTERVAL
            local now = tick()
            if now - lastFireTime < MIN_SHOT_INTERVAL then
                task.wait(MIN_SHOT_INTERVAL - (now - lastFireTime))
            end
            lastFireTime = tick()
            return _orig(self, ...)
        end))
    end)
end

task.spawn(function()
    task.wait(2)
    for _, obj in ipairs(game:GetDescendants()) do pcall(wrapShootRemote, obj) end
    game.DescendantAdded:Connect(function(obj) task.wait(0.1); pcall(wrapShootRemote, obj) end)
end)

