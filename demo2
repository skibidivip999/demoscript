local function getTarget(fov)
    local best,bd=nil,fov
    local cx=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr==LocalPlayer then continue end
        if Config.TeamCheckEnabled and plr.Team==LocalPlayer.Team then continue end
        local char=plr.Character; if not char then continue end
        local part=char:FindFirstChild(Config.AimbotPart) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local sp,on=Camera:WorldToViewportPoint(part.Position)
        if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-cx).Magnitude
        if d<bd then bd=d; best=plr end
    end
    return best
end

local function predictPos(character,part)
    if not Config.PredictionOn then return part.Position end
    local r=character:FindFirstChild("HumanoidRootPart")
    if not r then return part.Position end
    return part.Position+r.AssemblyLinearVelocity*(LocalPlayer:GetNetworkPing()+Config.PredictionStrength)
end

local _ls=0
local function fireWeapon()
    local now=tick(); if now-_ls<0.02 then return end; _ls=now
    local char=LocalPlayer.Character; if not char then return end
    local tool=char:FindFirstChildOfClass("Tool"); if not tool then return end
    for _,obj in ipairs(tool:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n=obj.Name:lower()
            if n:find("shoot") or n:find("fire") or n:find("attack") or n:find("bullet") then
                pcall(function() obj:FireServer() end); return
            end
        end
    end
    pcall(function() tool:Activate() end)
    pcall(function() mouse1click() end)
end

-- RAPID FIRE
local rapidConn=nil
local function startRapidFire()
    if rapidConn then rapidConn:Disconnect() end
    rapidConn=RunService.Heartbeat:Connect(function()
        if not Config.RapidFireEnabled then return end
        local now=tick(); if now-_ls<Config.FireRate then return end
        local char=LocalPlayer.Character; if not char then return end
        local tool=char:FindFirstChildOfClass("Tool"); if not tool then return end
        for _,obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local n=obj.Name:lower()
                if n:find("shoot") or n:find("fire") then
                    pcall(function() obj:FireServer() end); _ls=now; return
                end
            end
        end
        for _,v in ipairs(tool:GetDescendants()) do
            if (v:IsA("NumberValue") or v:IsA("IntValue")) then
                local n=v.Name:lower()
                if n:find("cooldown") or n:find("rate") or n:find("delay") then
                    pcall(function() v.Value=Config.FireRate end)
                end
            end
        end
    end)
end

-- WALLBANG
local wbHooked=false
local function setupWallbang()
    if wbHooked then return end; wbHooked=true
    pcall(function()
        local _orc=workspace.Raycast
        workspace.Raycast=function(self,o,d,p)
            if Config.WallbangEnabled then
                local nw=RaycastParams.new()
                nw.FilterType=Enum.RaycastFilterType.Exclude
                nw.FilterDescendantsInstances={LocalPlayer.Character or Instance.new("Folder")}
                local r=_orc(self,o,d,nw)
                if r then
                    local m=r.Instance:FindFirstAncestorOfClass("Model")
                    if m then
                        local pl=Players:GetPlayerFromCharacter(m)
                        if pl and pl~=LocalPlayer then
                            if not(Config.TeamCheckEnabled and pl.Team==LocalPlayer.Team) then
                                local h=m:FindFirstChildOfClass("Humanoid")
                                if h and h.Health>0 then return r end
                            end
                        end
                    end
                end
            end
            return _orc(self,o,d,p)
        end
    end)
end
setupWallbang()

