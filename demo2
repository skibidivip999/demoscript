local SkyPresets = {
    Sunset  = 6444320592,
    Space   = 6444320995,
    Rainbow = 6444319842,
}
local function ApplySky(name)
    local old = Lighting:FindFirstChildOfClass("Sky")
    if old then old:Destroy() end
    if name == "Default" then return end
    local id = SkyPresets[name]
    local sky = New("Sky", { Name = "NNSky" })
    if id then
        local uri = "rbxassetid://" .. id
        sky.SkyboxBk, sky.SkyboxDn, sky.SkyboxFt = uri, uri, uri
        sky.SkyboxLf, sky.SkyboxRt, sky.SkyboxUp = uri, uri, uri
    end
    sky.Parent = Lighting
end

