-- AD4: Detector object neutralizer + periodic rescan
local DETECTOR_NAMES = {
    "anticheat","anti_cheat","watchdog","guardian","monitor",
    "detector","sentinel","observer","integrity","validator",
}

local function neutralizeObj(obj)
    pcall(function()
        local name = obj.Name:lower()
        for _, p in ipairs(DETECTOR_NAMES) do
            if name:find(p, 1, true) then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("Script") or child:IsA("LocalScript") then
                        child.Disabled = true
                    end
                end
                -- Also try to destroy non-essential detector parts
                if obj:IsA("LocalScript") then
                    obj.Disabled = true
                end
                break
            end
        end
    end)
end

