                    pcall(function() o:FireServer(true) end)
                end
            end
        end
        local d = LocalPlayer:FindFirstChild("PlayerData") or LocalPlayer:FindFirstChild("Data")
        if d then
            for _, i in ipairs(d:GetDescendants()) do
                if i:IsA("BoolValue") then
                    local n = i.Name:lower()
                    if n:find("owned") or n:find("unlocked") or n:find("purchased") then i.Value = true end
                end
