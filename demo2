local apLast=0
task.spawn(function()
    while true do
        task.wait(0)
        if not Config.AutoPlayEnabled then task.wait(0.5); continue end
        pcall(function()
            local t=getTarget(Config.AimbotFOV); if not t or not t.Character then return end
