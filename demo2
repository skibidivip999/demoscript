-- ═══════ WALLBANG (rewritten) ═══════
local wallbangHits = {}

local function doWallbang()
    if not Config.WallbangEnabled then return end
    -- Instead of blocking hit, we detect if target is behind wall and send ray through
    local target = getTarget(Config.SilentAimFOV or 300)
    if not target or not target.Character then return end
    local char = target.Character
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return end

    -- Build ignore list for wallbang: ignore all parts except target's torso/head
    local ignore = {Camera}
    if LocalPlayer.Character then
        for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
            table.insert(ignore, p)
        end
    end

    -- Check if direct ray blocked
    local part = char:FindFirstChild(Config.AimbotPart) or char:FindFirstChild("HumanoidRootPart")
    if part then
        local toTarget = (part.Position - Camera.CFrame.Position).Unit
        local ray = Ray.new(Camera.CFrame.Position, toTarget*500)
        local hit = Workspace:FindPartOnRayWithIgnoreList(ray, ignore, false, true)

        if hit and hit:IsA("BasePart") and not hit:IsDescendantOf(char) then
            -- Blocked by wall. Try wallbang: find closest point on target collider through wall
            -- For Rivals-style games, wallbang works by sending damage through thin parts
            -- We'll just set our mouse target to enemy part regardless of wall
            -- Silent aim handles the rest; this is explicit wallbang flag
            table.insert(wallbangHits, {target=target, time=os.clock()})
        end
    end
end

