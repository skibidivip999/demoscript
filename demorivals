                if target then
                    local aimPos = target.Part.Position
                    if Settings.SilentAim.Prediction then
                        local pred = PredictPosition(target)
                        if pred then aimPos = pred end
                    end
                    if math.random(1, 100) <= Settings.SilentAim.HitChance then
                        return CFrame.new(Camera.CFrame.Position, aimPos)
                    end
                end
            end
            return oldIndex(self, key)
        end)
    end)
    
    -- Hook shooting remotes
    task.spawn(function()
        while task.wait(2) do
            pcall(function()
                for _, remote in pairs(getgc(true)) do
                    if type(remote) == "table" and type(rawget(remote, "FireServer")) == "function" then
                        local rName = tostring(remote):lower()
                        if rName:find("shoot") or rName:find("fire") or rName:find("bullet") then
                            local oldFire = remote.FireServer
                            remote.FireServer = newcclosure(function(self, ...)
                                if not Settings.SilentAim.Enabled then return oldFire(self, ...) end
                                local target = GetClosestTarget(Settings.SilentAim.FOV, Settings.SilentAim.AimPart, Settings.SilentAim.TeamCheck, Settings.SilentAim.WallCheck)
                                local args = {...}
                                if target then
                                    local aimPos = target.Part.Position
                                    if Settings.SilentAim.Prediction then
                                        local pred = PredictPosition(target)
                                        if pred then aimPos = pred end
                                    end
                                    for i, arg in pairs(args) do
                                        if typeof(arg) == "Vector3" then
                                            args[i] = aimPos
                                            break
                                        end
                                    end
                                end
                                return oldFire(self, unpack(args))
                            end)
                        end
                    end
                end
            end)
        end
    end)
end

