local function IsTeammate(targetPlayer)
    if targetPlayer == Player then return true end
    if targetPlayer.Team and Player.Team and targetPlayer.Team == Player.Team then return true end
    if targetPlayer.TeamColor and Player.TeamColor and targetPlayer.TeamColor == Player.TeamColor then return true end
    local char = targetPlayer.Character
    if char then
        local tag = char:FindFirstChild("Team") or char:FindFirstChild("TeamTag")
        if tag and Player.Character then
            local myTag = Player.Character:FindFirstChild("Team") or Player.Character:FindFirstChild("TeamTag")
            if myTag and tag.Value == myTag.Value then return true end
        end
    end
    return false
end

