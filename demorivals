local ESPObjects = {}
local function UpdateESP()
    for _, obj in pairs(ESPObjects) do
        pcall(function() obj:Remove() end)
    end
    table.clear(ESPObjects)
    if not Settings.ESP.Enabled then return end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == Player then continue end
        if Settings.ESP.TeamCheck and IsTeammate(plr) then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not root or not head then continue end
        
        local color = IsTeammate(plr) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 60, 60)
        
        -- Boxes
        if Settings.ESP.Boxes then
            local box = Drawing.new("Square")
            box.Color = color
            box.Thickness = 1.5
            box.Transparency = 0.7
            box.Filled = false
            box.Visible = true
            table.insert(ESPObjects, box)
            
            local updater
            updater = RunService.RenderStepped:Connect(function()
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if not onScreen or not hum or hum.Health <= 0 then
                    box.Visible = false
                    updater:Disconnect()
                    return
                end
                local dist = (Camera.CFrame.Position - root.Position).Magnitude
                if dist > Settings.ESP.MaxDistance then box.Visible = false; return end
                local scale = 250 / math.max(dist, 1)
                box.Position = Vector2.new(pos.X - (22.5*scale), pos.Y - (75*scale))
                box.Size = Vector2.new(45 * scale, 75 * scale)
                box.Visible = true
            end)
        end
        
        -- Tracers
        if Settings.ESP.Tracers then
            local tracer = Drawing.new("Line")
            tracer.Color = color
            tracer.Thickness = 1
            tracer.Transparency = 0.5
            tracer.Visible = true
            table.insert(ESPObjects, tracer)
            
            local updater
            updater = RunService.RenderStepped:Connect(function()
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen and hum and hum.Health > 0 and (Camera.CFrame.Position - root.Position).Magnitude <= Settings.ESP.MaxDistance then
                    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    tracer.To = Vector2.new(pos.X, pos.Y)
                    tracer.Visible = true
                else
                    tracer.Visible = false
                end
            end)
        end
        
        -- Health Bar
        if Settings.ESP.HealthBar then
            local hBar = Drawing.new("Line")
            hBar.Thickness = 3
            hBar.Visible = true
            table.insert(ESPObjects, hBar)
            
            local updater
            updater = RunService.RenderStepped:Connect(function()
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                if onScreen and hum and hum.Health > 0 and (Camera.CFrame.Position - root.Position).Magnitude <= Settings.ESP.MaxDistance then
                    local hp = hum.Health / hum.MaxHealth
                    hBar.From = Vector2.new(pos.X - 25, pos.Y)
                    hBar.To = Vector2.new(pos.X - 25 + (50*hp), pos.Y)
                    hBar.Color = hp > 0.5 and Color3.fromRGB(0,255,0) or hp > 0.25 and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,0,0)
                    hBar.Visible = true
                else
                    hBar.Visible = false
                end
            end)
        end
        
        -- Distance
        if Settings.ESP.Distance then
            local dText = Drawing.new("Text")
            dText.Color = Color3.fromRGB(255, 255, 255)
            dText.Size = 13
            dText.Center = true
            dText.Outline = true
            dText.Visible = true
            table.insert(ESPObjects, dText)
            
            local updater
            updater = RunService.RenderStepped:Connect(function()
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen and hum and hum.Health > 0 and (Camera.CFrame.Position - root.Position).Magnitude <= Settings.ESP.MaxDistance then
                    dText.Text = math.floor((Camera.CFrame.Position - root.Position).Magnitude) .. "m"
                    dText.Position = Vector2.new(pos.X, pos.Y - 45)
                    dText.Visible = true
                else
                    dText.Visible = false
                end
            end)
        end
        
        -- Names
        if Settings.ESP.Names then
            local nText = Drawing.new("Text")
            nText.Color = Color3.fromRGB(255, 255, 255)
            nText.Size = 13
            nText.Center = true
            nText.Outline = true
            nText.Visible = true
            table.insert(ESPObjects, nText)
            
            local updater
            updater = RunService.RenderStepped:Connect(function()
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2, 0))
                if onScreen and hum and hum.Health > 0 and (Camera.CFrame.Position - root.Position).Magnitude <= Settings.ESP.MaxDistance then
                    nText.Text = plr.DisplayName
                    nText.Position = Vector2.new(pos.X, pos.Y - 25)
                    nText.Visible = true
                else
                    nText.Visible = false
                end
            end)
        end
    end
end

